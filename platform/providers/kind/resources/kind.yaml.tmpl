kind: Cluster
apiVersion: kind.x-k8s.io/v1alpha4
nodes:
- role: control-plane
  image: "kindest/node:{{ .KubernetesVersion }}"
  labels:
    ingress-ready: "true"
  extraPortMappings:
  # Map host ports to nginx NodePorts for direct access without port forwarding
  - containerPort: 30080  # nginx NodePort for HTTP
    hostPort: {{ .HTTPPort | default 80 }}
    protocol: TCP
  - containerPort: 30443  # nginx NodePort for HTTPS  
    hostPort: {{ .HTTPSPort | default 443 }}
    protocol: TCP
  - containerPort: 32222
    hostPort: 32222
    protocol: TCP
  {{- range .ExtraPortsMapping }}
  - containerPort: {{ .ContainerPort }}
    hostPort: {{ .HostPort }}
    protocol: TCP
  {{- end }}
  extraMounts:
  - hostPath: .adhar/backup
    containerPath: /backup
  # Platform certificate, generated on the host BEFORE the cluster exists so
  # kube-apiserver can trust the Keycloak issuer for OIDC from its first start
  # (it refuses to boot when --oidc-ca-file is missing).
  - hostPath: {{ .PKIHostPath }}
    containerPath: /etc/adhar/pki
    readOnly: true
  # certs.d tree (rendered by the kind provider) giving containerd CA-verified
  # host config for the Gitea and Harbor in-cluster registries — see config.go
  # (renderRegistryCertsDir) and hosts.toml.tmpl.
{{- if .RegistryCertsDir }}
  - hostPath: {{ .RegistryCertsDir }}
    containerPath: /etc/containerd/certs.d
    readOnly: true
{{- end }}
{{- if .RegistryConfig }}
  - containerPath: /var/lib/kubelet/config.json
    hostPath: {{ .RegistryConfig }}
{{- end }}
# Control-plane tuning for local single-node clusters. On Docker Desktop the
# etcd data dir lives on a virtualized filesystem whose fsync latency spikes
# under the initial convergence write-storm (CRDs + ~18 ArgoCD apps reconciling
# at once). With the kube defaults (renew-deadline 10s) the controller-manager
# and scheduler lose their leader lease whenever an etcd write momentarily
# exceeds the deadline, crashloop, and stall every sync — cascading into
# repo-server / external-secrets webhook failures. Widening the leader-election
# windows lets the control plane ride out those latency spikes instead of
# flapping.
#
# NOTE: Kubernetes 1.37's kubeadm ONLY accepts the v1beta4 config API, where
# `extraArgs` is a name/value LIST (NOT the v1beta3 map[string]string). A map-form
# patch — or one tagged v1beta3 — is silently ignored on 1.37, which would drop
# the apiserver OIDC flags (breaking Keycloak API auth) and the leader-election
# tuning. The patch below is v1beta4 list form; kindest/node:v1.37.0+ uses it.
#
# maxPods: the kubelet default of 110 is a hard scheduling ceiling on a
# single-node cluster. The core stack alone runs ~100 pods, so enabling even a
# few optional packages produces "Too many pods" FailedScheduling — including
# for platform components (repo-server, metrics-server) whose pods then cannot
# reschedule after a restart, which reads as an unrelated ArgoCD outage.
kubeadmConfigPatches:
  - |
    kind: KubeletConfiguration
    maxPods: 250
    # kubelet defaults to pulling images one at a time; on first `adhar up` the
    # platform fetches 60+ images, so a serialized queue leaves pods stuck in
    # ContainerCreating for many minutes behind a single slow pull. Parallel
    # pulls cut initial convergence from tens of minutes to a few.
    serializeImagePulls: false
    maxParallelImagePulls: 8
  - |
    apiVersion: kubeadm.k8s.io/v1beta4
    kind: ClusterConfiguration
    # Skip etcd fsync (same trick kind CI uses): on Docker Desktop the etcd
    # data dir sits on a virtualized filesystem whose fsync latency under the
    # convergence write-storm pushes apiserver writes past the 5s leader-lease
    # client timeouts, crashlooping every operator. Throwaway local clusters
    # trade crash-durability for stable latency.
    etcd:
      local:
        extraArgs:
          - name: unsafe-no-fsync
            value: "true"
    apiServer:
      # Trust the platform Keycloak realm so human identities authenticate
      # against the Kubernetes API (ADR-0008): headlamp's OIDC sign-in and
      # `adhar auth login` tokens map onto the group-based RBAC bindings the
      # keycloak package ships (k8s-rbac.yaml). The oidc: prefixes keep
      # federated identities from ever colliding with system: users/groups.
      # Discovery runs against the issuer URL verbatim; on the node that
      # hostname resolves to loopback, where the oidc-loopback-proxy DaemonSet
      # (keycloak package) forwards 127.0.0.1:8443 to the Gateway. Requires
      # Cilium socketLB (hack/cilium/values.yaml) so host-namespace connects
      # reach cluster Services; the widened node-port range keeps the Gateway's
      # 8443 listener pinnable (gateway.go).
      extraArgs:
        - name: oidc-issuer-url
          value: "{{ .OIDCIssuerURL }}"
        - name: oidc-client-id
          value: "kubernetes"
        - name: oidc-ca-file
          value: "{{ .OIDCCAPath }}"
        - name: oidc-username-claim
          value: "preferred_username"
        - name: oidc-username-prefix
          value: "oidc:"
        - name: oidc-groups-claim
          value: "groups"
        - name: oidc-groups-prefix
          value: "oidc:"
        - name: service-node-port-range
          value: "8443-32767"
      # kubeadm mounts only a fixed set of paths into the kube-apiserver static
      # pod, so the node-level extraMount above is NOT visible to the process:
      # without this volume the API server dies at boot with
      # "open {{ .OIDCCAPath }}: no such file or directory" and the cluster
      # never finishes kubeadm init.
      extraVolumes:
      - name: adhar-pki
        hostPath: /etc/adhar/pki
        mountPath: /etc/adhar/pki
        readOnly: true
        pathType: DirectoryOrCreate
    controllerManager:
      extraArgs:
        - name: leader-elect-lease-duration
          value: "60s"
        - name: leader-elect-renew-deadline
          value: "45s"
        - name: leader-elect-retry-period
          value: "5s"
    scheduler:
      extraArgs:
        - name: leader-elect-lease-duration
          value: "60s"
        - name: leader-elect-renew-deadline
          value: "45s"
        - name: leader-elect-retry-period
          value: "5s"
networking:
  disableDefaultCNI: true   # do not install kindnet
  kubeProxyMode: none       # do not run kube-proxy - Cilium will replace it
# containerd 2.x accepts ONLY the certs.d/config_path mechanism for per-registry
# host config (inline registry.mirrors/registry.configs are rejected once
# config_path is set). Point it at the certs.d tree mounted below, which carries
# CA-verified host config for BOTH the platform Gitea registry and Harbor's
# in-cluster core Service (no skip_verify anywhere).
containerdConfigPatches:
- |-
  [plugins."io.containerd.grpc.v1.cri".registry]
    config_path = "/etc/containerd/certs.d"
