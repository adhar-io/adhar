      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (strimzi_io_cluster) (kafka_brokers{namespace=~\"$namespace\", strimzi_io_cluster=~\"$cluster\"})",
          "legendFormat": "{{strimzi_io_cluster}}",
          "range": true,
          "instant": false,
          "editorMode": "code",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
