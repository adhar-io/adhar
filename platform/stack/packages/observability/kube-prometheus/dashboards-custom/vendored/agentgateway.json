     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "editorMode": "code",
     "expr": "sum by (gen_ai_request_model) (increase(agentgateway_gen_ai_client_cost_usd_total{namespace=~\"$namespace\"}[$__rate_interval]))",
     "legendFormat": "{{gen_ai_request_model}}",
     "range": true,
     "refId": "A"
    }
   ],
   "title": "Cumulative USD cost by model",
