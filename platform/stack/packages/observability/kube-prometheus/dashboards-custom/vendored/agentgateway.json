  {
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "description": "Full upstream completion time. Compare against 'Gateway latency' above: the difference is agentgateway's own overhead, which should stay in the low milliseconds.",
   "fieldConfig": {
    "defaults": {
     "color": {
      "mode": "palette-classic"
     },
     "custom": {
      "axisLabel": "",
      "drawStyle": "line",
      "fillOpacity": 12,
      "lineWidth": 1,
      "showPoints": "never",
      "stacking": {
       "group": "A",
       "mode": "none"
      }
     },
     "min": 0,
     "unit": "s"
    },
    "overrides": []
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 38
   },
   "id": 16,
   "options": {
    "legend": {
     "calcs": [
      "mean",
      "lastNotNull"
     ],
     "displayMode": "table",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
