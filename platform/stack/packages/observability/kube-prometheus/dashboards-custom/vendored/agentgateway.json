  },
  {
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "description": "Perceived responsiveness for a streaming client (Console chat, `adhar ai`). Self-hosted models on CPU will be far worse here than hosted ones — expected, and the reason local/* is opt-in rather than the default.",
   "fieldConfig": {
    "defaults": {
     "color": {
      "mode": "palette-classic"
     },
     "custom": {
      "axisLabel": "",
      "drawStyle": "line",
