   "options": {
    "legend": {
     "calcs": [
      "mean",
      "lastNotNull"
     ],
     "displayMode": "table",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
