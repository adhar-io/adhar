    "overrides": []
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 22
   },
   "id": 13,
   "options": {
    "legend": {
     "calcs": [
      "mean",
      "lastNotNull"
     ],
     "displayMode": "table",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "editorMode": "code",
     "expr": "sum by (gen_ai_system, gen_ai_request_model) (rate(agentgateway_gen_ai_client_token_usage_sum{namespace=~\"$namespace\",gen_ai_token_type=\"output\"}[$__rate_interval]))",
     "legendFormat": "{{gen_ai_system}} · {{gen_ai_request_model}}",
     "range": true,
     "refId": "A"
    }
   ],
   "title": "Output tokens / sec by model and provider",
   "type": "timeseries"
  },
  {
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "description": "Realized spend per model. Models served by the in-cluster vLLM are absent or zero — the visible gap between a claude-* line and a local/* line is the saving from routing a task to the local model.",
   "fieldConfig": {
