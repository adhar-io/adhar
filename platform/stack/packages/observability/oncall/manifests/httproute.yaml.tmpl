# OnCall routed through the Cilium Gateway (adhar-gateway). TLS terminates at the
# Gateway, replacing the chart's bundled cert-manager/nginx Ingress (which also
# shipped its own ingress-nginx IngressClass, now removed). The original Ingress
# uses the platform's local host convention (oncall.adhar.localtest.me), which the
# controller rewrites to the configured base domain (e.g. oncall.platform.adhar.io)
# when seeding the stack into Gitea for cloud/on-prem clusters — no hardcoded domain.
# No rewrite annotations were present, so paths are forwarded as-is. Gateway API
# matches the most specific PathPrefix first, so /grafana takes precedence over /.
#
# SSO: every backend below is the Keycloak oauth2-proxy from sso.yaml, which
# forwards to the original upstream(s): oncall-grafana:80, oncall-engine:8080.
apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  name: oncall
  namespace: adhar-system
  annotations:
    # After the oauth2-proxy (sso.yaml, wave 5): ArgoCD holds a wave until its
    # resources are healthy, and a route whose backend Service does not exist
    # yet is Degraded (ResolvedRefs=False) — at an earlier wave that deadlocks
    # the sync on a fresh cluster and the proxy is never created.
    argocd.argoproj.io/sync-wave: "6"
  labels:
    app.kubernetes.io/name: oncall
    app.kubernetes.io/instance: oncall
    app.kubernetes.io/managed-by: Helm
spec:
  parentRefs:
    - name: adhar-gateway
      namespace: adhar-system
  hostnames:
    - oncall.adhar.localtest.me
  rules:
    # The bare host opens the OnCall UI. `/` is oncall-engine, an API whose root
    # answers "Ok"; the UI is the OnCall plugin inside the Grafana at /grafana.
    # A person following a link to oncall.<host> was left on a blank "Ok".
    - matches:
        - path:
            type: Exact
            value: /
          method: GET
      filters:
        - type: RequestRedirect
          requestRedirect:
            path:
              type: ReplaceFullPath
              replaceFullPath: /grafana/a/grafana-oncall-app/
            # Stated, or Gateway API defaults it to 443 and a local platform on
            # 8443 gets a Location nothing listens on.
            port: {{ .Port }}
            statusCode: 302
    - matches:
        - path:
            type: PathPrefix
            value: /grafana
      backendRefs:
        - name: oncall-oauth2-proxy
          port: 4180
    - matches:
        - path:
            type: PathPrefix
            value: /
      backendRefs:
        - name: oncall-oauth2-proxy
          port: 4180
