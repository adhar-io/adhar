# Platform ClusterIssuers (production edge).
#
# This file is a stack template: the AdharPlatform controller renders it with
# the platform spec (host, ACME email, DNS provider) when the stack is seeded
# into Gitea, so nothing here is hardcoded to a domain, an email or a cloud.
#
#   adhar-selfsigned         zero-configuration default; the cloud Gateway uses it
#                            when no DNS provider is configured (same trust posture
#                            as the local self-signed bootstrap certificate)
#   adhar-letsencrypt-*      HTTP-01 through the platform Gateway for per-application
#                            hostnames (HTTP-01 cannot issue wildcards)
#   adhar-letsencrypt-dns    DNS-01 for the platform wildcard *.<host>; rendered only
#                            when the DNS provider has a cert-manager solver. The
#                            Gateway's cert-manager.io/cluster-issuer annotation points
#                            here automatically (BuildCustomizationSpec.ACMEIssuer).
#                            Credentials come from the adhar-dns-provider Secret the CLI
#                            creates at bootstrap from the provider credentials — never
#                            from Git.
#
# The sync options let ArgoCD apply these CRs in the same sync as the
# cert-manager CRDs they depend on.
apiVersion: cert-manager.io/v1
kind: ClusterIssuer
metadata:
  name: adhar-selfsigned
  annotations:
    argocd.argoproj.io/sync-wave: "5"
    argocd.argoproj.io/sync-options: SkipDryRunOnMissingResource=true
spec:
  selfSigned: {}
---
apiVersion: cert-manager.io/v1
kind: ClusterIssuer
metadata:
  name: adhar-letsencrypt-staging
  annotations:
    argocd.argoproj.io/sync-wave: "5"
    argocd.argoproj.io/sync-options: SkipDryRunOnMissingResource=true
spec:
  acme:
    server: https://acme-staging-v02.api.letsencrypt.org/directory
    email: {{ .ACMEEmail }}
    privateKeySecretRef:
      name: adhar-letsencrypt-staging-account
    solvers:
      - http01:
          gatewayHTTPRoute:
            parentRefs:
              - kind: Gateway
                name: adhar-gateway
                namespace: adhar-system
---
apiVersion: cert-manager.io/v1
kind: ClusterIssuer
metadata:
  name: adhar-letsencrypt-prod
  annotations:
    argocd.argoproj.io/sync-wave: "5"
    argocd.argoproj.io/sync-options: SkipDryRunOnMissingResource=true
spec:
  acme:
    server: https://acme-v02.api.letsencrypt.org/directory
    email: {{ .ACMEEmail }}
    privateKeySecretRef:
      name: adhar-letsencrypt-prod-account
    solvers:
      - http01:
          gatewayHTTPRoute:
            parentRefs:
              - kind: Gateway
                name: adhar-gateway
                namespace: adhar-system
{{- if .HasDNS01 }}
---
# DNS-01 issuer for the platform wildcard certificate (*.{{ .Host }}). The
# solver is selected from the platform's DNS provider ({{ .DNSProvider }}); the
# selector restricts it to the platform zone so per-application certificates
# for other zones keep using HTTP-01.
apiVersion: cert-manager.io/v1
kind: ClusterIssuer
metadata:
  name: adhar-letsencrypt-dns
  annotations:
    argocd.argoproj.io/sync-wave: "5"
    argocd.argoproj.io/sync-options: SkipDryRunOnMissingResource=true
spec:
  acme:
    server: https://acme-v02.api.letsencrypt.org/directory
    email: {{ .ACMEEmail }}
    privateKeySecretRef:
      name: adhar-letsencrypt-dns-account
    solvers:
      - selector:
          dnsZones:
            - {{ .Host }}
        dns01:
{{- if eq .DNSProvider "digitalocean" }}
          digitalocean:
            tokenSecretRef:
              name: adhar-dns-provider
              key: access-token
{{- else if eq .DNSProvider "aws" }}
          route53:
            # region is REQUIRED. Without it the solver cannot even resolve the
            # Route 53 endpoint: the Challenge stays `pending` forever on
            # "Invalid Configuration: Missing Region", no _acme-challenge TXT
            # record is ever written, and the wildcard certificate never issues —
            # so every platform URL fails TLS while DNS, the load balancer and the
            # Gateway all look healthy. cert-manager only says why in its own pod
            # log (AWS, 2026-09-27).
            region: {{ .DNSRegion }}
            accessKeyIDSecretRef:
              name: adhar-dns-provider
              key: access-key-id
            secretAccessKeySecretRef:
              name: adhar-dns-provider
              key: secret-access-key
{{- else if eq .DNSProvider "gcp" }}
          cloudDNS:
            # project is REQUIRED by cert-manager. Without it the API server
            # rejects this ClusterIssuer outright ("spec.acme.solvers[0].dns01
            # .cloudDNS.project: Required value"), so the issuer never applies,
            # the wildcard certificate is never issued, and the Gateway quietly
            # keeps serving its self-signed fallback.
            project: {{ .DNSProject }}
            serviceAccountSecretRef:
              name: adhar-dns-provider
              key: credentials.json
{{- else if eq .DNSProvider "azure" }}
          azureDNS:
            # All four are REQUIRED by the solver schema and must be inline — only
            # the client secret may be a secretRef. Omitting resourceGroupName had
            # the API server reject this whole ClusterIssuer, so the wildcard
            # certificate could never be issued.
            clientID: {{ .DNSAzureClientID }}
            clientSecretSecretRef:
              name: adhar-dns-provider
              key: client-secret
            subscriptionID: {{ .DNSAzureSubscriptionID }}
            tenantID: {{ .DNSAzureTenantID }}
            resourceGroupName: {{ .DNSAzureResourceGroup }}
            hostedZoneName: {{ .Host }}
            environment: AzurePublicCloud
{{- else if eq .DNSProvider "civo" }}
          # Civo has no BUILT-IN cert-manager solver, so this routes through the
          # webhook solver installed by civo-dns-webhook.yaml.tmpl (wave 4, ahead
          # of these issuers). Before it existed a Civo platform published DNS
          # records happily and then served a self-signed certificate on every
          # URL, because this template simply had no civo branch and fell through
          # to the selfsigned issuer.
          #
          # secretName/secretKey are the webhook's own config keys, not
          # cert-manager's tokenSecretRef — it reads the token itself, from the
          # same adhar-dns-provider Secret external-dns uses.
          webhook:
            groupName: civo.webhook.okteto.com
            solverName: civo
            config:
              secretName: adhar-dns-provider
              secretKey: CIVO_TOKEN
{{- else if eq .DNSProvider "cloudflare" }}
          cloudflare:
            apiTokenSecretRef:
              name: adhar-dns-provider
              key: api-token
{{- end }}
{{- end }}
