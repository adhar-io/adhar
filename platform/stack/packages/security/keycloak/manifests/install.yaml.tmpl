apiVersion: v1
kind: Service
metadata:
  name: keycloak
  labels:
    app: keycloak
spec:
  ports:
  - name: http
    port: 8080
    targetPort: 8080
  # Keycloak 25+ serves health (/health/*) and Prometheus metrics (/metrics) on a
  # dedicated management interface (port 9000), scraped by the ServiceMonitor.
  - name: management
    port: 9000
    targetPort: 9000
  selector:
    app: keycloak
  type: ClusterIP
---
apiVersion: apps/v1
kind: Deployment
metadata:
  labels:
    app: keycloak
  name: keycloak
  namespace: adhar-system
  annotations:
    argocd.argoproj.io/sync-wave: '10'
spec:
  replicas: 1
  selector:
    matchLabels:
      app: keycloak
  template:
    metadata:
      labels:
        app: keycloak
    spec:
      # Head of the identity path — see manifests/priorityclass.yaml.
      priorityClassName: adhar-critical-path
      containers:
      - args:
        - start-dev
        env:
        # Keycloak 26 renamed the bootstrap-admin env vars (KEYCLOAK_ADMIN /
        # KEYCLOAK_ADMIN_PASSWORD are deprecated). Username inline; password
        # mapped from the existing keycloak-config secret key so secret-gen.yaml
        # is unchanged.
        - name: KC_BOOTSTRAP_ADMIN_USERNAME
          value: adhar-admin
        - name: KC_BOOTSTRAP_ADMIN_PASSWORD
          valueFrom:
            secretKeyRef:
              name: keycloak-config
              key: KEYCLOAK_ADMIN_PASSWORD
        # INFO instead of the previous ALL: TRACE/ALL is a boot-time performance
        # drag and leaks request internals into logs (hardening).
        - name: KC_LOG_LEVEL
          value: INFO
        - name: QUARKUS_TRANSACTION_MANAGER_ENABLE_RECOVERY
          value: 'true'
        # Health (/health/*) and Prometheus metrics (/metrics) are served on the
        # dedicated management interface (port 9000) in Keycloak 25+.
        - name: KC_METRICS_ENABLED
          value: 'true'
        - name: KC_HEALTH_ENABLED
          value: 'true'
        envFrom:
        - secretRef:
            name: keycloak-config
        image: quay.io/keycloak/keycloak:26.8.0
        imagePullPolicy: IfNotPresent
        name: keycloak
        ports:
        - containerPort: 8080
          name: http
        - containerPort: 9000
          name: management
        # A startupProbe is a DEADLINE, not just a shield: when its budget runs
        # out kubelet kills the container. The budget was 30s + 30x10s = 5m30s
        # against a comment that assumed "2-3 min", and on the first GCP bring-up
        # (2026-10-03) Keycloak needed longer than that, so kubelet killed
        # it at 5m58s with exit 137 ("failed startup probe, will be restarted")
        # and it re-entered the same doomed build on every restart. Nothing
        # downstream recovers from that: Keycloak's wave-20 config Job never runs,
        # `keycloak-clients` is never written, and every consumer ExternalSecret
        # plus the whole adhar-console app sits Degraded behind it — the platform
        # looked like 39/75 apps converging when it was really one pod in a loop.
        #
        # 30s + 90x10s = 15m30s. A generous budget costs NOTHING when boot is
        # fast: the probe stops the moment /health/started answers 200. It only
        # ever spends the time a genuinely slow first boot needs — a cold image
        # pull (56s measured), the `kc.sh build` augmentation for the custom theme,
        # and first-time DB schema creation, all while ~70 other apps sync.
        # readiness still gates SSO traffic on the real health endpoints (9000).
        startupProbe:
          httpGet:
            path: /health/started
            port: 9000
          initialDelaySeconds: 30
          periodSeconds: 10
          timeoutSeconds: 5
          failureThreshold: 90
        readinessProbe:
          httpGet:
            path: /health/ready
            port: 9000
          periodSeconds: 20
          timeoutSeconds: 10
          failureThreshold: 6
        livenessProbe:
          httpGet:
            path: /health/live
            port: 9000
          periodSeconds: 30
          timeoutSeconds: 10
          failureThreshold: 6
        resources:
          requests:
            cpu: 200m
            memory: 512Mi
          limits:
            # NO CPU limit. `cpu: '1'` was measured holding this container at
            # exactly 1001m for the entire `kc.sh build` while the cluster's
            # workers sat at 28-66% — the boot was throttled against idle cores,
            # which is what pushed it past the startup budget above. Keycloak's
            # first boot is the platform's critical path (CNPG -> keycloak-db ->
            # this JVM -> the client Job -> ~12 ExternalSecrets -> 9 oauth2-proxy
            # rollouts), so a CFS quota here delays everything and protects
            # nothing: the burst is a few minutes long and ends by itself. Same
            # reasoning that gave Gitea its own limit relief.
            #
            # Memory stays 1Gi: measured 513Mi in steady state, so this is real
            # headroom rather than a guess, and an OOM here would be a crash
            # rather than a slow start.
            memory: 1Gi
        # Hardening: non-root (the image runs as uid 1000), no privilege
        # escalation, drop all Linux capabilities, default seccomp profile.
        securityContext:
          runAsNonRoot: true
          allowPrivilegeEscalation: false
          capabilities:
            drop: ["ALL"]
          seccompProfile:
            type: RuntimeDefault
        volumeMounts:
        - mountPath: /opt/keycloak/conf
          name: keycloak-config
          readOnly: true
        # Adhar-branded login theme (keycloak-theme-adhar ConfigMap). The realm's
        # loginTheme=adhar (keycloak-config.yaml) selects it. start-dev disables
        # theme caching so edits reflect on pod restart.
        - mountPath: /opt/keycloak/themes/adhar
          name: theme-adhar
          readOnly: true
      volumes:
      - configMap:
          name: keycloak-config
        name: keycloak-config
      # items[].path carries the nested theme layout (login/theme.properties,
      # login/resources/css/adhar.css, login/resources/js/adhar-theme.js,
      # login/resources/img/*.svg) from the flat ConfigMap keys — ConfigMap keys
      # cannot contain '/'. Every key the ConfigMap generator emits
      # (hack/gen-keycloak-theme-configmap.sh) must be listed here, or the file
      # simply will not exist in the pod.
      - name: theme-adhar
        configMap:
          name: keycloak-theme-adhar
          items:
          - key: theme.properties
            path: login/theme.properties
          - key: adhar.css
            path: login/resources/css/adhar.css
          - key: adhar-theme.js
            path: login/resources/js/adhar-theme.js
          - key: adhar-symbol.svg
            path: login/resources/img/adhar-symbol.svg
          - key: adhar-logo.svg
            path: login/resources/img/adhar-logo.svg
---
apiVersion: v1
data:
  keycloak.conf: |
    # Database (CNPG-managed keycloak-db cluster; credentials via the
    # keycloak-config secret's KC_DB_USERNAME/KC_DB_PASSWORD).
    db=postgres
    db-url=jdbc:postgresql://keycloak-db-rw.adhar-system.svc.cluster.local:5432/keycloak

    # Reverse proxy: TLS terminates at the Cilium Gateway (Envoy). Keycloak 26
    # replaced `proxy=edge` with `proxy-headers`; trust X-Forwarded-* from the
    # in-cluster gateway and listen plain HTTP.
    proxy-headers=xforwarded
    http-enabled=true

    # Hostname v2 (Keycloak 26): a single absolute frontend URL (replaces the v1
    # hostname/hostname-port/hostname-strict keys). Keycloak owns its subdomain,
    # served at root. Issuer: https://keycloak.adhar.localtest.me:8443/realms/adhar
    hostname=https://keycloak.adhar.localtest.me:8443
    hostname-admin=https://keycloak.adhar.localtest.me:8443

    # Backchannel (server-side OIDC) requests resolve to the fixed hostname above
    # by default in v2 — do NOT set hostname-backchannel-dynamic. This replaces the
    # old hostname-strict-backchannel=true: the console does in-cluster http
    # backchannel OIDC (KEYCLOAK_INTERNAL_URL=http://keycloak...svc:8080); a fixed
    # https issuer keeps discovery URLs + the token 'iss' claim consistent so both
    # the console's id-token verification AND kube-apiserver (--oidc-issuer-url is
    # https) accept the tokens.

    # Observability: health (/health/*) + Prometheus metrics (/metrics) on the
    # dedicated management interface (port 9000).
    health-enabled=true
    metrics-enabled=true
kind: ConfigMap
metadata:
  name: keycloak-config
  namespace: adhar-system
---
apiVersion: postgresql.cnpg.io/v1
kind: Cluster
metadata:
  name: keycloak-db
  namespace: adhar-system
  annotations:
    argocd.argoproj.io/sync-wave: '5'
    # See console-db: CNPG Clusters overflow client-side apply's last-applied
    # annotation; pin ServerSideApply so ArgoCD uses SSA/force-conflicts instead
    # of the invalid replace(--force) + --server-side combination.
    argocd.argoproj.io/sync-options: ServerSideApply=true
spec:
  # Node-bound: this instance's volume pins it to one node (node-local default
  # StorageClass), so it has no alternative placement and must be able to preempt
  # pods that do. See data/cnpg/manifests/priorityclass.yaml.
  priorityClassName: adhar-node-bound
  # One instance on a laptop; a primary + replica in HA mode (matches the
  # bootstrap-phase gitea-db). Rendered at seed time from the platform spec.
  instances: {{ if .EnableHAMode }}2{{ else }}1{{ end }}
  # Expose the instance exporter to kube-prometheus: CNPG creates a PodMonitor
  # (skipped gracefully while the monitoring CRDs are absent) so the Platform and
  # CloudNativePG dashboards show this cluster. Without it no cnpg_* series exist.
  monitoring:
    enablePodMonitor: true
  storage:
    # 1Gi filled up in a day: WAL is retained locally whenever archiving
    # to MinIO hiccups (keycloak-db went down with "Not enough disk space").
    size: 5Gi
  # Guaranteed CPU/memory so the database is not starved during the initial
  # convergence write-storm. Without a request, the Postgres process was
  # CPU-throttled under load — a trivial `SELECT ID FROM REALM` took 35s, the
  # Agroal pool tripped "connection in incorrect state VALIDATION", the DB health
  # check went DOWN, and Keycloak logins timed out / failed intermittently.
  resources:
    requests:
      cpu: 100m
      memory: 256Mi
    limits:
      memory: 512Mi
  # Postgres tuning for a small, latency-sensitive auth DB on a single node.
  postgresql:
    parameters:
      shared_buffers: 128MB
      max_connections: "100"
  bootstrap:
    initdb:
      database: keycloak
      owner: keycloak
      secret:
        name: keycloak-config
  # Scheduled base backups + WAL archiving to the platform object store
  # (roadmap P1.5). Credentials are the object store's root-creds (the rustfs package
  # creates bucket adhar-backups); point destinationPath/endpointURL at real
  # object storage in cloud environments. WAL archiving logs warnings until
  # the rustfs package is healthy, then self-heals.
  backup:
    retentionPolicy: 7d  # a week of PITR; 30d of WAL for every platform DB filled the shared MinIO
    barmanObjectStore:
      destinationPath: s3://adhar-backups/cnpg/keycloak-db
      endpointURL: http://rustfs.adhar-system.svc.cluster.local:9000
      s3Credentials:
        accessKeyId:
          name: root-creds
          key: rootUser
        secretAccessKey:
          name: root-creds
          key: rootPassword
      # gzip, always. Every CNPG cluster archives a WAL segment every
      # `archive_timeout` (5 min by default) whether or not anything changed, so
      # an idle database still ships 288 × 16 MiB = 4.6 GiB/day UNCOMPRESSED.
      # Eight clusters doing that filled the 100 GiB object store to 100 % and
      # took WAL archiving, Loki, Mimir and the buckets Job down with it
      # (2026-09-25). A near-empty segment gzips to a few KB.
      wal:
        compression: gzip
---
# Daily base backup at 01:30 UTC (before the Velero object backup at 02:00);
# point-in-time recovery between base backups comes from WAL archiving.
apiVersion: postgresql.cnpg.io/v1
kind: ScheduledBackup
metadata:
  name: keycloak-db-daily
  namespace: adhar-system
  annotations:
    argocd.argoproj.io/sync-wave: '6'
spec:
  schedule: "0 30 1 * * *"
  backupOwnerReference: self
  cluster:
    name: keycloak-db
