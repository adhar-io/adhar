# LitmusChaos ChaosCenter routed through the Cilium Gateway (adhar-gateway). TLS
# terminates at the Gateway (adhar-cert); the chart Ingress stays disabled.
#
# SSO: the backend is the Keycloak oauth2-proxy from sso.yaml, which forwards to
# litmus-frontend-service:9091. One upstream is enough for the whole console —
# the frontend's own nginx proxies /auth/ to the auth server and /api/ to the
# graphql server (including the websocket the experiment view subscribes on), so
# routing the SPA routes the API with it.
apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  name: litmus
  namespace: adhar-system
  annotations:
    # After the oauth2-proxy (sso.yaml, wave 5): ArgoCD holds a wave until its
    # resources are healthy, and a route whose backend Service does not exist
    # yet is Degraded (ResolvedRefs=False) — at an earlier wave that deadlocks
    # the sync on a fresh cluster and the proxy is never created.
    argocd.argoproj.io/sync-wave: "6"
  labels:
    app.kubernetes.io/name: litmus
    app.kubernetes.io/component: chaoscenter
    app.kubernetes.io/part-of: litmus
spec:
  parentRefs:
    - name: adhar-gateway
      namespace: adhar-system
  hostnames:
    - litmus.adhar.localtest.me
  # Click-free sign-in (manifests/oidc.yaml). ChaosCenter keeps its token in
  # localStorage, so the edge cannot see a session; it keys on a marker cookie
  # it sets when the sign-in completes. Gateway API precedence: an Exact path
  # beats a prefix, and among equal paths more header/query matches win.
  rules:
    # The return from Keycloak: the auth server sends the browser to
    # /login?jwtToken=…, which ChaosCenter stores. Mark the browser so `/`
    # goes straight through afterwards (8 h, about a working day).
    - matches:
        - path: {type: Exact, value: /login}
          queryParams:
            - {type: RegularExpression, name: jwtToken, value: ".+"}
      filters:
        - type: ResponseHeaderModifier
          responseHeaderModifier:
            add:
              - name: Set-Cookie
                value: "adhar_sso_litmus=1; Path=/; Max-Age=28800; Secure; SameSite=Lax"
      backendRefs:
        - name: litmus-oauth2-proxy
          port: 4180
    # Any other full load of the login page starts Keycloak sign-in — the same
    # URL ChaosCenter's "Sign in with SSO" button links to.
    - matches:
        - path: {type: Exact, value: /login}
      filters:
        - type: RequestRedirect
          requestRedirect:
            path: {type: ReplaceFullPath, replaceFullPath: /auth/oauth/login}
            port: {{ .Port }}
            statusCode: 302
    # The home page: through once signed in here, otherwise start sign-in.
    - matches:
        - path: {type: Exact, value: /}
          headers:
            - {type: RegularExpression, name: Cookie, value: '.*adhar_sso_litmus=[^;]+.*'}
      backendRefs:
        - name: litmus-oauth2-proxy
          port: 4180
    - matches:
        - path: {type: Exact, value: /}
      filters:
        - type: RequestRedirect
          requestRedirect:
            path: {type: ReplaceFullPath, replaceFullPath: /auth/oauth/login}
            port: {{ .Port }}
            statusCode: 302
    - matches:
        - path:
            type: PathPrefix
            value: /
      backendRefs:
        - name: litmus-oauth2-proxy
          port: 4180
