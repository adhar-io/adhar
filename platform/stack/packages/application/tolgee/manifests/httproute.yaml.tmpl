# Tolgee routed through the Cilium Gateway (adhar-gateway) at tolgee.<host>.
# TLS terminates at the Gateway (adhar-cert). Rendered at seed time (the
# redirect ports below); the adhar.localtest.me convention is rewritten to the
# platform's real domain.
#
# NO oauth2-proxy in front: Tolgee signs people in with Keycloak itself
# (keycloak-client.yaml), keeps its session as a JWT in localStorage, and
# serves the CLI and the runtime SDKs on the same host with API keys.
#
# Click-free sign-in (security/keycloak/manifests/sso-start.yaml, tolgee.html).
# Tolgee's "Log in with OAuth2" button carries a `state` the sign-in page
# generates and keeps in localStorage (`oauth2State`), and its callback page
# rejects a return whose state it did not store, so a Gateway redirect cannot
# start the flow on Tolgee's behalf the way the Coder and Plane routes do. A
# page on THIS host can: a bare load of `/` or `/login` goes to
# /adhar-sso/tolgee.html (same origin, so Tolgee's localStorage), which bounces
# straight back to Tolgee when a live Tolgee session is already stored, and
# otherwise writes the state exactly as the button does and goes to Keycloak —
# which already holds the session and returns to Tolgee's own callback at once.
#
# Loop safety: the start page sets `adhar_sso_tolgee` (8 h once a session is
# confirmed, 5 min while a sign-in is in flight or after a failure) and every
# place it sends the browser — Tolgee's callback, `/projects`,
# `/login?local=1` — is a path the redirect below never matches. A broken
# Keycloak therefore costs one click on Tolgee's sign-in page, never a loop.
#
# Rule precedence (Gateway API): an Exact path beats a prefix, then a METHOD
# match beats any number of header matches, then more header matches win, then
# more query matches. So no rule here carries a method: a `method: GET` on the
# redirect alone would outrank the cookie pass-through below and send every
# load of `/` back to the start page.
#
# Break-glass: /login?local=1 always reaches Tolgee's own sign-in page (the
# `admin` password login). Deep links, the API (/v2, /api) and the CLI/SDK
# traffic are never redirected.
apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  name: tolgee
  namespace: adhar-system
  # Wave 7, WITH the Service and Deployment, not after them. Argo CD applies a
  # whole wave before it waits on health, so the route exists while Tolgee is
  # still starting (a 503 until it is ready). At wave 8 it waited on the
  # Deployment: on a cluster at its maxWorkers the pod stayed Pending past its
  # progress deadline, the sync retried forever, and with no route the
  # console's app drawer had no Tolgee tile at all (AWS, 2026-10-24).
  annotations: {argocd.argoproj.io/sync-wave: "7"}
  labels:
    app.kubernetes.io/name: tolgee
    app.kubernetes.io/part-of: tolgee
spec:
  parentRefs:
    - name: adhar-gateway
      namespace: adhar-system
  hostnames:
    - tolgee.adhar.localtest.me
  rules:
    # Native SIGN-UP is closed. Registrations must stay "allowed" for Keycloak
    # users to get an account on first sign-in, and Tolgee has no switch for
    # "SSO sign-up only" while password login is on, so the edge refuses the
    # password sign-up endpoint and its page. A POST answered with 302 is
    # re-issued by the browser as a GET to /login: no account is created.
    - matches:
        - path:
            type: Exact
            value: /api/public/sign_up
        - path:
            type: PathPrefix
            value: /sign_up
      filters:
        - type: RequestRedirect
          requestRedirect:
            path:
              type: ReplaceFullPath
              replaceFullPath: /login
            # Stated, or Gateway API defaults it to 443 and a local platform on
            # 8443 gets a Location nothing listens on.
            port: {{ .Port }}
            statusCode: 302
    # Spring Boot's actuator (health, metrics) is for the kubelet and
    # Prometheus, which reach it adhar-controlplane; it has no business on the edge.
    - matches:
        - path:
            type: PathPrefix
            value: /actuator
      filters:
        - type: RequestRedirect
          requestRedirect:
            path:
              type: ReplaceFullPath
              replaceFullPath: /
            port: {{ .Port }}
            statusCode: 302
    # The start page itself, served by the keycloak package's adhar-sso-start.
    - matches:
        - path: {type: PathPrefix, value: /adhar-sso/}
      backendRefs:
        - name: adhar-sso-start
          port: 80
    # Break-glass, and where the start page falls back to: Tolgee's own sign-in
    # page with the password form.
    - matches:
        - path: {type: Exact, value: /login}
          queryParams:
            - {type: Exact, name: local, value: "1"}
      backendRefs:
        - name: tolgee
          port: 8080
    # The start page already ran: straight to Tolgee.
    - matches:
        - path: {type: Exact, value: /}
          headers:
            - {type: RegularExpression, name: Cookie, value: '.*adhar_sso_tolgee=[^;]+.*'}
        - path: {type: Exact, value: /login}
          headers:
            - {type: RegularExpression, name: Cookie, value: '.*adhar_sso_tolgee=[^;]+.*'}
      backendRefs:
        - name: tolgee
          port: 8080
    # Any other load of the home or sign-in page starts the Keycloak sign-in.
    - matches:
        - path: {type: Exact, value: /}
        - path: {type: Exact, value: /login}
      filters:
        - type: RequestRedirect
          requestRedirect:
            path: {type: ReplaceFullPath, replaceFullPath: /adhar-sso/tolgee.html}
            port: {{ .Port }}
            statusCode: 302
    - matches:
        - path:
            type: PathPrefix
            value: /
      backendRefs:
        - name: tolgee
          port: 8080
