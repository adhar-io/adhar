# Plane routed through the Cilium Gateway (adhar-gateway). TLS terminates at the
# Gateway (adhar-cert), replacing the chart's Traefik IngressRoute (disabled in
# values.yaml). This mirrors Plane's upstream path-based routing across its
# services.
#
# NOTE: Plane serves its main app at the root path (/) and uses absolute prefixes
# (/spaces, /god-mode, /api, /auth, /live, /uploads). On the shared
# adhar.localtest.me hostname these would collide with other apps' root paths, so
# in production Plane should be given its OWN hostname (e.g. plane.localtest.me)
# and the rules below moved under that hostname. For local single-app use this
# routes the Plane prefixes; the catch-all root rule is intentionally omitted to
# avoid hijacking the shared host.
#
# SSO: every backend below is the Keycloak oauth2-proxy from sso.yaml, which
# forwards to the original upstream(s): plane-space:3000, plane-admin:3000, plane-api:8000, plane-live:3000, plane-minio:9000, plane-web:3000.
apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  name: plane
  namespace: adhar-system
  annotations:
    # After the oauth2-proxy (sso.yaml, wave 5): ArgoCD holds a wave until its
    # resources are healthy, and a route whose backend Service does not exist
    # yet is Degraded (ResolvedRefs=False) — at an earlier wave that deadlocks
    # the sync on a fresh cluster and the proxy is never created.
    argocd.argoproj.io/sync-wave: "6"
  labels:
    app.kubernetes.io/name: plane
    app.kubernetes.io/instance: plane
    app.kubernetes.io/part-of: plane
spec:
  parentRefs:
    - name: adhar-gateway
      namespace: adhar-system
  hostnames:
    - plane.adhar.localtest.me
  rules:
    # Single sign-on, without Plane's own sign-in page. Plane draws a page with
    # one button ("Continue with Keycloak") to anyone without a Plane session,
    # so a person already signed in to Keycloak was asked to sign in again.
    # Its Keycloak start URL completes silently against that session instead.
    # A request that CARRIES Plane's session cookie is served as before — the
    # header match ranks above the path-only redirect below.
    - matches:
        - path:
            type: Exact
            value: /
          method: GET
          headers:
            - type: RegularExpression
              name: Cookie
              value: "(^|.*;\\s*)session-id=[^;]+.*"
      backendRefs:
        - name: plane-oauth2-proxy
          port: 4180
    - matches:
        - path:
            type: Exact
            value: /
          method: GET
      filters:
        - type: RequestRedirect
          requestRedirect:
            path:
              type: ReplaceFullPath
              replaceFullPath: /auth/keycloak/
            # The port is stated ONLY when it is not the scheme's default: a
            # local platform on 8443 needs it, or the Location points at 443,
            # where nothing listens. Behind a real 443 it is left to the
            # listener. Note Cilium's Envoy still writes `:443` into the
            # Location either way (verified 2026-10-24); browsers drop a
            # default port, so Plane sees `Host: plane.<host>` and its OIDC
            # callback matches the Keycloak client. Only a client that keeps
            # `:443` (curl) sends a redirect_uri Keycloak refuses.
{{- if .PortSuffix }}
            port: {{ .Port }}
{{- end }}
            statusCode: 302
    - matches:
        - path:
            type: PathPrefix
            value: /spaces
      backendRefs:
        - name: plane-oauth2-proxy
          port: 4180
    - matches:
        - path:
            type: PathPrefix
            value: /god-mode
      backendRefs:
        - name: plane-oauth2-proxy
          port: 4180
    - matches:
        - path:
            type: PathPrefix
            value: /api
        - path:
            type: PathPrefix
            value: /auth
      backendRefs:
        - name: plane-oauth2-proxy
          port: 4180
    - matches:
        - path:
            type: PathPrefix
            value: /live
      backendRefs:
        - name: plane-oauth2-proxy
          port: 4180
    # The `plane` bucket, straight to the object store. Uploads and downloads
    # are presigned against this host (USE_MINIO=1, generate-manifests.sh), so
    # the URL carries its own SigV4 signature and must NOT go through the SSO
    # proxy, which would hand it to Plane's web app instead of to S3. Only this
    # bucket's path is exposed, and the bucket is private: an unsigned request
    # is refused by RustFS. PathPrefix matches whole segments, so /plane does
    # not catch a /planes... path.
    - matches:
        - path:
            type: PathPrefix
            value: /plane
      backendRefs:
        - name: rustfs
          port: 9000
    - matches:
        - path:
            type: PathPrefix
            value: /uploads
      backendRefs:
        - name: plane-oauth2-proxy
          port: 4180
    - matches:
        - path:
            type: PathPrefix
            value: /
      backendRefs:
        - name: plane-oauth2-proxy
          port: 4180
