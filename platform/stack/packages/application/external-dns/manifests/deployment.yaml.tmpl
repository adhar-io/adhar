# external-dns Deployment — a stack template rendered by the AdharPlatform
# controller with the platform spec when the stack is seeded into Gitea.
#
# The chart-generated install.yaml carries everything else (ServiceAccount,
# RBAC, Service); the Deployment lives here because its provider, zone filter,
# owner id and credentials depend on the cluster:
#
#   provider        BuildCustomizationSpec.ExternalDNSProvider — the edge DNS backend
#                   derived from the cloud provider / globalSettings.dnsProvider;
#                   "inmemory" on a local cluster (no cloud calls, no credentials)
#   domain-filter   the platform host, so only the platform zone is touched
#   txt-owner-id    adhar-<cluster>, so several clusters can share one zone
#   credentials     the adhar-dns-provider Secret created by the CLI at bootstrap
#                   (never in Git), exposed as the provider's own env vars/files
#
# Records are published from Service, Ingress and Gateway API HTTPRoute
# hostnames (every platform HTTPRoute → <app>.<host> → the Gateway LB).
apiVersion: apps/v1
kind: Deployment
metadata:
  name: external-dns
  namespace: adhar-system
  labels:
    app.kubernetes.io/name: external-dns
    app.kubernetes.io/instance: external-dns
    app.kubernetes.io/managed-by: adhar
spec:
  replicas: 1
  selector:
    matchLabels:
      app.kubernetes.io/name: external-dns
      app.kubernetes.io/instance: external-dns
  strategy:
    type: Recreate
  template:
    metadata:
      labels:
        app.kubernetes.io/name: external-dns
        app.kubernetes.io/instance: external-dns
    spec:
      automountServiceAccountToken: true
      serviceAccountName: external-dns
      securityContext:
        fsGroup: 65534
        runAsNonRoot: true
        seccompProfile:
          type: RuntimeDefault
      containers:
        - name: external-dns
          securityContext:
            allowPrivilegeEscalation: false
            capabilities:
              drop:
                - ALL
            privileged: false
            readOnlyRootFilesystem: true
            runAsGroup: 65532
            runAsNonRoot: true
            runAsUser: 65532
          image: registry.k8s.io/external-dns/external-dns:v0.15.1
          imagePullPolicy: IfNotPresent
          args:
            - --log-level=info
            - --log-format=text
            - --interval=1m
            # Initial informer sync lists every Service/Endpoints in the cluster;
            # on a full platform (hundreds of pods, aggregated APIs still coming
            # up) the default 30s is too short and the controller exits fatally.
            - --request-timeout=3m
            # Platform hostnames are Gateway API HTTPRoutes (plus any Ingress a
            # package still ships). The `service` source is deliberately absent:
            # it needs a cluster-wide Endpoints informer, whose initial list on a
            # full platform exceeds external-dns' fixed 60s sync deadline and
            # crash-loops the controller; Service-type LoadBalancer records are
            # not part of the platform's DNS contract.
            - --source=ingress
            - --source=gateway-httproute
            - --policy=upsert-only
            - --registry=txt
            - --txt-owner-id={{ .TXTOwnerID }}
            - --provider={{ .ExternalDNSProvider }}
{{- if .DNSProvider }}
            - --domain-filter={{ .Host }}
{{- end }}
{{- if eq .DNSProvider "gcp" }}
            - --google-project=$(GOOGLE_PROJECT)
{{- end }}
{{- if eq .DNSProvider "azure" }}
            - --azure-config-file=/etc/adhar-dns/azure.json
{{- end }}
{{- if .DNSProvider }}
          env:
{{- if eq .DNSProvider "digitalocean" }}
            - name: DO_TOKEN
              valueFrom:
                secretKeyRef:
                  name: adhar-dns-provider
                  key: DO_TOKEN
{{- else if eq .DNSProvider "aws" }}
            - name: AWS_ACCESS_KEY_ID
              valueFrom:
                secretKeyRef:
                  name: adhar-dns-provider
                  key: AWS_ACCESS_KEY_ID
            - name: AWS_SECRET_ACCESS_KEY
              valueFrom:
                secretKeyRef:
                  name: adhar-dns-provider
                  key: AWS_SECRET_ACCESS_KEY
            - name: AWS_DEFAULT_REGION
              valueFrom:
                secretKeyRef:
                  name: adhar-dns-provider
                  key: AWS_DEFAULT_REGION
                  optional: true
{{- else if eq .DNSProvider "gcp" }}
            - name: GOOGLE_APPLICATION_CREDENTIALS
              value: /etc/adhar-dns/credentials.json
            - name: GOOGLE_PROJECT
              valueFrom:
                secretKeyRef:
                  name: adhar-dns-provider
                  key: project
{{- else if eq .DNSProvider "civo" }}
            - name: CIVO_TOKEN
              valueFrom:
                secretKeyRef:
                  name: adhar-dns-provider
                  key: CIVO_TOKEN
{{- else if eq .DNSProvider "cloudflare" }}
            - name: CF_API_TOKEN
              valueFrom:
                secretKeyRef:
                  name: adhar-dns-provider
                  key: CF_API_TOKEN
{{- end }}
{{- end }}
          ports:
            - name: http
              protocol: TCP
              containerPort: 7979
          livenessProbe:
            failureThreshold: 2
            httpGet:
              path: /healthz
              port: http
            initialDelaySeconds: 10
            periodSeconds: 10
            successThreshold: 1
            timeoutSeconds: 5
          readinessProbe:
            failureThreshold: 6
            httpGet:
              path: /healthz
              port: http
            initialDelaySeconds: 5
            periodSeconds: 10
            successThreshold: 1
            timeoutSeconds: 5
{{- if or (eq .DNSProvider "gcp") (eq .DNSProvider "azure") }}
          volumeMounts:
            - name: adhar-dns-provider
              mountPath: /etc/adhar-dns
              readOnly: true
      volumes:
        - name: adhar-dns-provider
          secret:
            secretName: adhar-dns-provider
{{- end }}
