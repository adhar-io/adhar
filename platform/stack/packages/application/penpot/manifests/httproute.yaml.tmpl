# Penpot routed through the Cilium Gateway (adhar-gateway). TLS terminates at the
# Gateway (adhar-cert), replacing the chart's Ingress (disabled in values.yaml).
# Everything goes to the penpot frontend (nginx, port 8080), which proxies the
# API to the backend; there is no oauth2-proxy in front — Penpot signs people in
# itself with native OIDC against Keycloak (values.yaml).
apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  name: penpot
  namespace: adhar-system
  annotations:
    # After the chart's Services (wave 0): a route whose backend Service does
    # not exist yet is ResolvedRefs=False, which Argo CD reads as Degraded.
    argocd.argoproj.io/sync-wave: "6"
  labels:
    app.kubernetes.io/name: penpot
    app.kubernetes.io/instance: penpot
    app.kubernetes.io/part-of: penpot
spec:
  parentRefs:
    - name: adhar-gateway
      namespace: adhar-system
  hostnames:
    - penpot.adhar.localtest.me
  # Click-free sign-in (security/keycloak/manifests/sso-start.yaml, penpot.html).
  # Penpot starts OIDC with a POST, which no redirect can make, so a page load of
  # `/` goes to /adhar-sso/penpot.html on this host first. The SPA's own routes
  # are fragments (#/workspace?…, #/auth/login), so `/` is the only path a page
  # load ever requests, and the browser carries the fragment through the 302.
  #
  # FRAMING. The Adhar Console embeds Penpot's viewer (a share link,
  # /#/view?file-id=…&share-id=…) in an iframe. Penpot's nginx sends
  # `X-Frame-Options: SAMEORIGIN` on every response (2.17.2
  # docker/images/files/nginx-security-headers.conf, `always`), and
  # console.<host> is not penpot.<host>'s origin, so the browser refused the
  # frame. Every rule that serves content therefore swaps that header for
  # `Content-Security-Policy: frame-ancestors 'self' https://console.<host>`:
  # Penpot and the console may frame it, nothing else may (the start page
  # below included, which sent no framing header at all). Penpot sends no CSP
  # of its own, so `set` replaces nothing. The redirect rule needs neither: a
  # 302 is never rendered in a frame. The host is the local convention,
  # rewritten to the platform's at seed time. Cilium 1.20 translates the filter
  # into Envoy response_headers_to_remove / response_headers_to_add
  # (OVERWRITE_IF_EXISTS_OR_ADD). Guard: TestPenpotRouteLetsOnlyTheConsoleFrameIt.
  rules:
    - matches:
        - path: {type: PathPrefix, value: /adhar-sso/}
      filters:
        - type: ResponseHeaderModifier
          responseHeaderModifier:
            remove: [X-Frame-Options]
            set:
              - name: Content-Security-Policy
                value: "frame-ancestors 'self' https://console.adhar.localtest.me:8443"
      backendRefs:
        - name: adhar-sso-start
          port: 80
    # Straight to Penpot only with the start page's marker (`adhar_sso_penpot`):
    # it has just checked that the session is live (1 h), handed back the
    # result of a sign-in (10 min) or fallen back to the login screen (5 min).
    # Penpot's own `auth-token` is deliberately NOT enough: Penpot keeps
    # answering a cookie whose session is gone (rebuilt cluster, new
    # PENPOT_SECRET_KEY, session GC) as the anonymous user and never clears it,
    # so trusting it parked people on the login page for up to the cookie's
    # 7 days instead of signing them in.
    - matches:
        - path: {type: Exact, value: /}
          headers:
            - type: RegularExpression
              name: Cookie
              value: '.*adhar_sso_penpot=[^;]+.*'
      filters:
        - type: ResponseHeaderModifier
          responseHeaderModifier:
            remove: [X-Frame-Options]
            set:
              - name: Content-Security-Policy
                value: "frame-ancestors 'self' https://console.adhar.localtest.me:8443"
      backendRefs:
        - name: penpot
          port: 8080
    - matches:
        - path: {type: Exact, value: /}
      filters:
        - type: RequestRedirect
          requestRedirect:
            path: {type: ReplaceFullPath, replaceFullPath: /adhar-sso/penpot.html}
            port: {{ .Port }}
            statusCode: 302
    - matches:
        - path:
            type: PathPrefix
            value: /
      filters:
        - type: ResponseHeaderModifier
          responseHeaderModifier:
            remove: [X-Frame-Options]
            set:
              - name: Content-Security-Policy
                value: "frame-ancestors 'self' https://console.adhar.localtest.me:8443"
      backendRefs:
        - name: penpot
          port: 8080
