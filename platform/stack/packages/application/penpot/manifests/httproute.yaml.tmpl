# Penpot routed through the Cilium Gateway (adhar-gateway). TLS terminates at the
# Gateway (adhar-cert), replacing the chart's Ingress (disabled in values.yaml).
# Requests to /penpot are forwarded to the penpot frontend service on port 8080.
# config.publicUri is set to the external /penpot URL in values.yaml.
#
# SSO: every backend below is the Keycloak oauth2-proxy from sso.yaml, which
# forwards to the original upstream(s): penpot:8080.
apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  name: penpot
  namespace: adhar-system
  annotations:
    # After the oauth2-proxy (sso.yaml, wave 5): ArgoCD holds a wave until its
    # resources are healthy, and a route whose backend Service does not exist
    # yet is Degraded (ResolvedRefs=False) — at an earlier wave that deadlocks
    # the sync on a fresh cluster and the proxy is never created.
    argocd.argoproj.io/sync-wave: "6"
  labels:
    app.kubernetes.io/name: penpot
    app.kubernetes.io/instance: penpot
    app.kubernetes.io/part-of: penpot
spec:
  parentRefs:
    - name: adhar-gateway
      namespace: adhar-system
  hostnames:
    - penpot.adhar.localtest.me
  # Click-free sign-in (security/keycloak/manifests/sso-start.yaml). Penpot
  # starts OIDC with a POST, which no redirect can make, so a bare load of `/`
  # with no session goes to /adhar-sso/penpot.html on this host, which makes
  # that POST and follows Keycloak's URL. The SPA's own routes are fragments
  # (#/auth/login), so `/` is the only path a page load ever requests.
  rules:
    - matches:
        - path: {type: PathPrefix, value: /adhar-sso/}
      backendRefs:
        - name: adhar-sso-start
          port: 80
    # Signed in (Penpot's `auth-token`), or the start page fell back to the
    # login screen (`adhar_sso_penpot`, 5 min): straight to Penpot.
    - matches:
        - path: {type: Exact, value: /}
          headers:
            - type: RegularExpression
              name: Cookie
              value: '.*(auth-token|adhar_sso_penpot)=[^;]+.*'
      backendRefs:
        - name: penpot
          port: 8080
    - matches:
        - path: {type: Exact, value: /}
      filters:
        - type: RequestRedirect
          requestRedirect:
            path: {type: ReplaceFullPath, replaceFullPath: /adhar-sso/penpot.html}
            port: {{ .Port }}
            statusCode: 302
    - matches:
        - path:
            type: PathPrefix
            value: /
      backendRefs:
        - name: penpot
          port: 8080
