# LibreDB Studio routed through the Cilium Gateway (adhar-gateway). TLS
# terminates at the Gateway (adhar-cert), replacing the chart's Ingress (left
# disabled in values.yaml — never an nginx Ingress). Served on its own host,
# libredb.<host>, because the app speaks OIDC itself and its callback
# (/api/auth/oidc/callback) is a root-relative path.
apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  name: libredb-studio
  namespace: adhar-system
  annotations:
    # After the Service (wave 0, from the chart): ArgoCD holds a wave until its
    # resources are healthy, and an HTTPRoute whose backend Service does not
    # exist yet is Degraded (ResolvedRefs=False).
    argocd.argoproj.io/sync-wave: "2"
  labels:
    app.kubernetes.io/name: libredb-studio
    app.kubernetes.io/instance: libredb-studio
    app.kubernetes.io/part-of: libredb-studio
spec:
  parentRefs:
    - name: adhar-gateway
      namespace: adhar-system
  hostnames:
    - libredb.adhar.localtest.me
  rules:
    # Single sign-on: libredb's /login page only offers an OIDC button, so a
    # person already signed in to Keycloak was asked to sign in again. Its OIDC
    # start URL completes silently against the Keycloak session.
    - matches:
        - path:
            type: Exact
            value: /login
          method: GET
      filters:
        - type: RequestRedirect
          requestRedirect:
            path:
              type: ReplaceFullPath
              replaceFullPath: /api/auth/oidc/login
            # Stated, or Gateway API defaults it to 443 and a local platform on
            # 8443 gets a Location nothing listens on.
            port: {{ .Port }}
            statusCode: 302
    - matches:
        - path:
            type: PathPrefix
            value: /
      backendRefs:
        - name: libredb-studio
          port: 80
