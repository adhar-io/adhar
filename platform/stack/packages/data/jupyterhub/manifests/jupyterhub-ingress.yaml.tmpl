# JupyterHub routed through the Cilium Gateway (adhar-gateway). TLS terminates
# at the Gateway (adhar-cert). JupyterHub is served at the subdomain root (no
# hub.baseUrl), matching the grafana/minio pattern, so no URLRewrite filter.
# The previous ReplacePrefixMatch "/" -> "/jupyterhub" (paired with
# baseUrl: /jupyterhub) double-prefixed every browser request after the first
# redirect (/jupyterhub/hub/... -> /jupyterhub/jupyterhub/hub/...), leaving the
# UI stuck loading. Backend proxy-public:80 (plain HTTP).
apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  name: jupyterhub
  namespace: adhar-system
spec:
  parentRefs:
    - name: adhar-gateway
      namespace: adhar-system
  hostnames:
    - jupyterhub.adhar.localtest.me
    - localhost
  rules:
    # Single sign-on: the hub's login page only offers a "Sign in with keycloak"
    # button, so a person who already signed in to Keycloak was asked to click
    # again. Its OAuth start URL completes silently against the Keycloak session.
    - matches:
        - path:
            type: Exact
            value: /hub/login
          method: GET
      filters:
        - type: RequestRedirect
          requestRedirect:
            path:
              type: ReplaceFullPath
              replaceFullPath: /hub/oauth_login
            # Stated, or Gateway API defaults it to 443 and a local platform on
            # 8443 gets a Location nothing listens on.
            port: {{ .Port }}
            statusCode: 302
    - matches:
        - path:
            type: PathPrefix
            value: /
      backendRefs:
        - name: proxy-public
          port: 80
