{
  "apiVersion": "batch/v1",
  "kind": "Job",
  "metadata": {
    "annotations": {
      "adhar.io/batch-actor": ""
    },
    "labels": {
      "adhar.io/application": "reconciler",
      "adhar.io/batch-job": "reconciler",
      "adhar.io/batch-role": "single",
      "adhar.io/batch-trigger": "manual",
      "adhar.io/environment": "dev",
      "adhar.io/organisation": "acme",
      "adhar.io/plane": "workload",
      "adhar.io/project": "shop",
      "adhar.io/team": "payments",
      "adhar.io/workload": "batch",
      "app.kubernetes.io/name": "reconciler"
    },
    "name": "run-ok",
    "namespace": "dev"
  },
  "spec": {
    "activeDeadlineSeconds": 21600,
    "backoffLimit": 2,
    "completionMode": "NonIndexed",
    "completions": 1,
    "manualSelector": false,
    "parallelism": 1,
    "podFailurePolicy": {
      "rules": [
        {
          "action": "Ignore",
          "onPodConditions": [
            {
              "status": "True",
              "type": "DisruptionTarget"
            }
          ]
        },
        {
          "action": "FailJob",
          "onExitCodes": {
            "containerName": "batch",
            "operator": "In",
            "values": [
              2,
              3,
              4,
              6,
              7
            ]
          }
        }
      ]
    },
    "podReplacementPolicy": "Failed",
    "selector": {
      "matchLabels": {
        "batch.kubernetes.io/controller-uid": "ffee02c4-eea5-4e1f-8549-4661a269f063"
      }
    },
    "suspend": false,
    "template": {
      "metadata": {
        "annotations": {
          "adhar.io/batch-actor": "",
          "cluster-autoscaler.kubernetes.io/safe-to-evict": "false"
        },
        "labels": {
          "adhar.io/application": "reconciler",
          "adhar.io/batch-job": "reconciler",
          "adhar.io/batch-role": "single",
          "adhar.io/batch-trigger": "manual",
          "adhar.io/environment": "dev",
          "adhar.io/organisation": "acme",
          "adhar.io/plane": "workload",
          "adhar.io/project": "shop",
          "adhar.io/team": "payments",
          "adhar.io/workload": "batch",
          "app.kubernetes.io/name": "reconciler",
          "batch.kubernetes.io/controller-uid": "ffee02c4-eea5-4e1f-8549-4661a269f063",
          "batch.kubernetes.io/job-name": "run-ok",
          "controller-uid": "ffee02c4-eea5-4e1f-8549-4661a269f063",
          "job-name": "run-ok"
        }
      },
      "spec": {
        "containers": [
          {
            "env": [
              {
                "name": "ADHAR_BATCH_JOB",
                "value": "reconcileJob"
              },
              {
                "name": "ADHAR_BATCH_NAME",
                "value": "reconciler"
              },
              {
                "name": "ADHAR_BATCH_ROLE",
                "value": "single"
              },
              {
                "name": "ADHAR_BATCH_TRIGGER",
                "value": "manual"
              },
              {
                "name": "ADHAR_BATCH_PARAMS",
                "value": "{}"
              },
              {
                "name": "ADHAR_BATCH_TIME_ZONE",
                "value": "UTC"
              },
              {
                "name": "ADHAR_BATCH_REPOSITORY_SCHEMA",
                "value": "batch"
              },
              {
                "name": "ADHAR_BATCH_SHUTDOWN_TIMEOUT",
                "value": "90s"
              },
              {
                "name": "ADHAR_BATCH_K8S_JOB",
                "valueFrom": {
                  "fieldRef": {
                    "apiVersion": "v1",
                    "fieldPath": "metadata.labels['batch.kubernetes.io/job-name']"
                  }
                }
              },
              {
                "name": "ADHAR_BATCH_ACTOR",
                "valueFrom": {
                  "fieldRef": {
                    "apiVersion": "v1",
                    "fieldPath": "metadata.annotations['adhar.io/batch-actor']"
                  }
                }
              },
              {
                "name": "POD_NAME",
                "valueFrom": {
                  "fieldRef": {
                    "apiVersion": "v1",
                    "fieldPath": "metadata.name"
                  }
                }
              },
              {
                "name": "POD_UID",
                "valueFrom": {
                  "fieldRef": {
                    "apiVersion": "v1",
                    "fieldPath": "metadata.uid"
                  }
                }
              },
              {
                "name": "NODE_NAME",
                "valueFrom": {
                  "fieldRef": {
                    "apiVersion": "v1",
                    "fieldPath": "spec.nodeName"
                  }
                }
              },
              {
                "name": "ADHAR_ENVIRONMENT",
                "value": "dev"
              },
              {
                "name": "SPRING_DATASOURCE_URL",
                "valueFrom": {
                  "secretKeyRef": {
                    "key": "jdbc-uri",
                    "name": "reconciler-db-app"
                  }
                }
              },
              {
                "name": "SPRING_DATASOURCE_USERNAME",
                "valueFrom": {
                  "secretKeyRef": {
                    "key": "username",
                    "name": "reconciler-db-app"
                  }
                }
              },
              {
                "name": "SPRING_DATASOURCE_PASSWORD",
                "valueFrom": {
                  "secretKeyRef": {
                    "key": "password",
                    "name": "reconciler-db-app"
                  }
                }
              },
              {
                "name": "BPL_JVM_THREAD_COUNT",
                "value": "50"
              },
              {
                "name": "JAVA_TOOL_OPTIONS",
                "value": "-XX:ReservedCodeCacheSize=64M"
              },
              {
                "name": "OTEL_EXPORTER_OTLP_ENDPOINT",
                "value": "http://alloy.adhar-system.svc.cluster.local:4318"
              },
              {
                "name": "OTEL_EXPORTER_OTLP_PROTOCOL",
                "value": "http/protobuf"
              },
              {
                "name": "OTEL_METRICS_EXPORTER",
                "value": "otlp"
              },
              {
                "name": "OTEL_RESOURCE_ATTRIBUTES",
                "value": "deployment.environment.name=dev,deployment.environment=dev,service.namespace=dev"
              },
              {
                "name": "OTEL_SERVICE_NAME",
                "value": "reconciler"
              }
            ],
            "image": "harbor-core.adhar-system.svc.cluster.local/library/reconciler:1.0.0",
            "imagePullPolicy": "IfNotPresent",
            "name": "batch",
            "resources": {
              "limits": {
                "memory": "1536Mi"
              },
              "requests": {
                "cpu": "1",
                "memory": "1536Mi"
              }
            },
            "securityContext": {
              "allowPrivilegeEscalation": false,
              "capabilities": {
                "drop": [
                  "ALL"
                ]
              }
            },
            "terminationMessagePath": "/dev/termination-log",
            "terminationMessagePolicy": "File",
            "volumeMounts": [
              {
                "mountPath": "/tmp",
                "name": "tmp"
              }
            ]
          }
        ],
        "dnsPolicy": "ClusterFirst",
        "enableServiceLinks": false,
        "imagePullSecrets": [
          {
            "name": "harbor-dockercfg"
          }
        ],
        "priorityClassName": "adhar-batch",
        "restartPolicy": "Never",
        "schedulerName": "default-scheduler",
        "securityContext": {
          "runAsNonRoot": true,
          "seccompProfile": {
            "type": "RuntimeDefault"
          }
        },
        "serviceAccount": "reconciler-batch",
        "serviceAccountName": "reconciler-batch",
        "terminationGracePeriodSeconds": 120,
        "volumes": [
          {
            "emptyDir": {
              "sizeLimit": "1Gi"
            },
            "name": "tmp"
          }
        ]
      }
    },
    "ttlSecondsAfterFinished": 604800
  }
}
